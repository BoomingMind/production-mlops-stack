# ==================== DATA ====================
# Exclude raw and processed data (too large for git)
data/raw/*.csv
data/raw/*.json
data/processed/*.csv
data/processed/*.json

# ChromaDB vector database (regenerate with: make rag-ingest)
data/chromadb/

# Keep directory structure with .gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/chromadb/.gitkeep

# Knowledge base files are tracked for RAG pipeline
!data/knowledge/

# ==================== MODELS ====================
# Exclude trained models (use DVC or S3 instead)
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.pth
models/*.onnx
models/*.pb

# Keep directory structure
!models/.gitkeep
!models/README.md

# ==================== JUPYTER ====================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# Jupyter Notebook outputs (optional - uncomment to keep notebooks clean)
# *.ipynb

